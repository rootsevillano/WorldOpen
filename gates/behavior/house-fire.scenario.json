{
  "name": "house-fire",
  "description": "G1/G3: Dios incendia una vivienda a las 20:00. Sus ocupantes huyen al instante, sus vecinos lo recuerdan, esa noche duermen en un servicio público y la casa vuelve a usarse tras repararse.",
  "seeds": [1, 2, 3, 4, 5],
  "days": 4,
  "manifest": { "criteria": { "society.initialPopulation": 200 } },
  "commands": [
    { "type": "disaster.fire", "version": 1, "atHour": 14, "payload": { "buildingId": "@populatedHome[0]" } }
  ],
  "assertions": [
    { "kind": "deterministic" },
    { "kind": "metric", "metric": "building.@populatedHome[0].state", "op": "==", "value": 1, "at": { "day": 0, "hour": 20, "minute": 2 } },
    { "kind": "metric", "metric": "building.@populatedHome[0].occupants", "op": "==", "value": 0, "at": { "day": 0, "hour": 20, "minute": 2 } },
    { "kind": "metric", "metric": "events.fire.started", "op": "==", "value": 1, "at": { "day": 0, "hour": 21 } },
    { "kind": "metric", "metric": "building.@populatedHome[0].occupants", "op": "==", "value": 0, "at": { "day": 1, "hour": 2 } },
    { "kind": "metric", "metric": "agents.sleepingRatio", "op": ">=", "value": 0.95, "at": { "day": 1, "hour": 2 } },
    { "kind": "metric", "metric": "building.@populatedHome[0].state", "op": "==", "value": 0, "at": { "day": 3, "hour": 12 } },
    { "kind": "metric", "metric": "building.@populatedHome[0].residentsAtHome", "op": ">", "value": 0, "at": { "day": 4, "hour": 2 }, "minPassRatio": 0.8 }
  ]
}
