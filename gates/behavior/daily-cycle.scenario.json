        "day": 1,
        "hour": 4
      }
    },
    {
      "kind": "metric",
      "metric": "agents.avgHealth",
      "op": ">=",
      "value": 0.95
    },
    {
      "kind": "metric",
      "metric": "animals.outdoorsRatio",
      "op": ">=",
      "value": 0.5,
      "at": {
        "day": 0,
        "hour": 12
      }
    },
    {
      "kind": "metric",
      "metric": "animals.outdoorsRatio",
      "op": "<=",
      "value": 0.05,
      "at": {
        "day": 1,
        "hour": 0
      }
    },
    {
      "kind": "metric",
      "metric": "animals.dogsWalkedRatio",
      "op": ">=",
