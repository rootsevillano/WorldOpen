  "assertions": [
    { "kind": "deterministic" },
    { "kind": "metric", "metric": "events.traffic.jam", "op": ">=", "value": 1, "minPassRatio": 0.5 },
    { "kind": "metric", "metric": "events.bus.arrived", "op": ">=", "value": 45 },
    { "kind": "metric", "metric": "roads.slowestLink", "op": ">", "value": 0.9, "at": { "day": 1, "hour": 3, "minute": 0 } }
  ]
}
