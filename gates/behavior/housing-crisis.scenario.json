{
  "name": "housing-crisis",
  "description": "ADR-0024: con alquileres desorbitados (×10, ≈ 3 000 al mes con viviendas de sobra) los hogares de alquiler agotan sus ahorros, acumulan impagos y, tras un mes, los desahucian y se van del pueblo; la ayuda de emergencia cubre la comida (nadie muere de hambre) pero no el alquiler, y no llega nadie a vivir. Ticks de 10 min.",
  "seeds": [
    1,
    2
  ],
  "days": 90,
  "manifest": {
    "time": {
      "minutesPerTick": 10,
      "start": {
        "year": 1,
        "month": 3,
        "day": 21,
        "hour": 6,
        "minute": 0
      }
    },
    "criteria": {
      "society.initialPopulation": 200,
      "economy.rentLevel": 10
    }
  },
  "assertions": [
    {
      "kind": "deterministic"
    },
    {
      "kind": "metric",
      "metric": "events.household.evicted",
      "op": ">=",
      "value": 1
    },
    {
      "kind": "metric",
      "metric": "events.agent.emigrated:reason=eviction",
      "op": ">=",
      "value": 2
    },
    {
      "kind": "metric",
      "metric": "agents.count",
      "op": "<",
      "value": 200
    },
    {
      "kind": "metric",
      "metric": "events.agent.died:cause=starvation",
      "op": "==",
      "value": 0
    }
  ]
}
